<div id="<%= dom_id movie %>" class="card">
  <div>
    <strong>Title:</strong>
    <%= movie.title %>
  </div>

  <div>
    <strong>Rating:</strong>
    <%= movie.rating %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= movie.description %>
  </div>

  <div>
    <strong>Release date:</strong>
    <%= movie.release_date&.strftime("%B %-d, %Y") %>
  </div>

  <div>
    <strong>Director:</strong>
    <%= movie.director %>
  </div>

  <div>
    <strong>Stars:</strong>
    <%= star_rating(movie.stars) %>
  </div>

</div>
